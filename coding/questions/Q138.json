    "Java": "import java.io.*;import java.util.*;class Node{int val;Node next,random;Node(int v){val=v;}} class Solution{public Node copyRandomList(Node head){if(head==null)return null;Node c=head;while(c!=null){Node x=new Node(c.val);x.next=c.next;c.next=x;c=x.next;}c=head;while(c!=null){if(c.random!=null)c.next.random=c.random.next;c=c.next.next;}Node d=new Node(0),t=d;c=head;while(c!=null){Node x=c.next;c.next=x.next;t.next=x;t=x;c=c.next;}return d.next;}} public class Main{static int[][] parse(String s){int p=s.indexOf(\"[[\");if(p<0)return new int[0][0];p+=2;List<int[]> z=new ArrayList<>();while(p<s.length()&&s.charAt(p)!=']'){while(p<s.length()&&(s.charAt(p)==','||Character.isWhitespace(s.charAt(p))))p++;if(p>=s.length()||s.charAt(p)!='[')break;int q=s.indexOf(']',p);String x=s.substring(p+1,q);String[] a=x.split(\",\");int v=Integer.parseInt(a[0].trim());int r=a[1].trim().equals(\"null\")?-1:Integer.parseInt(a[1].trim());z.add(new int[]{v,r});p=q+1;}return z.toArray(new int[0][]);}public static void main(String[]x)throws Exception{String s=new BufferedReader(new InputStreamReader(System.in)).readLine();int[][]p=parse(s);Node h=null,t=null;Node[]n=new Node[p.length];for(int i=0;i<p.length;i++){n[i]=new Node(p[i][0]);if(h==null)h=n[i];else t.next=n[i];t=n[i];}for(int i=0;i<p.length;i++)if(p[i][1]>=0)n[i].random=n[p[i][1]];Node c=new Solution().copyRandomList(h);List<Node>o=new ArrayList<>();for(Node q=c;q!=null;q=q.next)o.add(q);IdentityHashMap<Node,Integer>m=new IdentityHashMap<>();for(int i=0;i<o.size();i++)m.put(o.get(i),i);StringBuilder b=new StringBuilder(\"[\");for(int i=0;i<o.size();i++){if(i>0)b.append(',');b.append('[').append(o.get(i).val).append(',');b.append(o.get(i).random==null?\"null\":m.get(o.get(i).random));b.append(']');}b.append(']');System.out.println(b);}}",
